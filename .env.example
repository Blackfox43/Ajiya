# AJIYA Crisis Safety Network - Environment Configuration
# API keys and secrets can be configured via the Secrets panel in AI Studio or in your .env file.

# Termii SMS Gateway (https://termii.com) for real-time cellular SMS dispatch across Africa
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=AJIYA_ALERT

# Paystack Payment Gateway (https://paystack.com) for NGN Naira cards, bank transfers & USSD
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# Supabase Realtime Backend (https://supabase.com) for peer-to-peer circle synchronization
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Emergency National Hotline (e.g., 112 in Nigeria / West Africa, 911 in US)
EMERGENCY_HOTLINE=112

